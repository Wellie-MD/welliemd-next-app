# API Configuration
VITE_API_BASE_URL=https://api.welliemd.com/v1
VITE_API_TIMEOUT=10000

# Authentication
VITE_AUTH_TOKEN_KEY=welliemd_auth_token
VITE_REFRESH_TOKEN_KEY=welliemd_refresh_token
VITE_TOKEN_REFRESH_THRESHOLD=300000

# Feature Flags
VITE_ENABLE_FEATURE_FLAGS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true

# Environment
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=Client Name
VITE_PORTAL_MODE=dtc
VITE_CORPORATE_PILOT_ENABLED=false

# External Services
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

# Development
VITE_MOCK_API=false
VITE_DEBUG_MODE=true
